package model

type WorkflowCapability string

const (
	CapabilityView     WorkflowCapability = "view"
	CapabilityExternal WorkflowCapability = "external"
	CapabilityHybrid   WorkflowCapability = "hybrid"
)

type WorkflowSection struct {
	Key             string
	Slug            string
	Label           string
	Capability      WorkflowCapability
	OpenCodeCmd     string
	ClaudeCmd       string
	SourceArtifacts []string
	DashboardView   string
	EmptyStateHint  string
}

type WorkflowStatusItem struct {
	Label string
	Value string
}

type WorkflowSectionStatus struct {
	Section      WorkflowSection
	Availability string
	Summary      string
	Source       string
	Items        []WorkflowStatusItem
	Notes        []string
}

var workflowSections = []WorkflowSection{
	{
		Key:             "1",
		Slug:            "discovery",
		Label:           "DISCOVERY",
		Capability:      CapabilityHybrid,
		OpenCodeCmd:     "/career-ops-scan | python pipeline/run_pipeline.py ...",
		ClaudeCmd:       "/career-ops scan",
		SourceArtifacts: []string{"data/pipeline.md", "data/external_jobs.json"},
		DashboardView:   "Discovery screen",
		EmptyStateHint:  "Run discovery import/scan and refresh.",
	},
	{
		Key:             "2",
		Slug:            "pipeline",
		Label:           "PIPELINE",
