func WorkflowSections() []WorkflowSection {
	out := make([]WorkflowSection, len(workflowSections))
	copy(out, workflowSections)
	return out
}

func WorkflowSectionByKey(key string) (WorkflowSection, bool) {
	for _, section := range workflowSections {
		if section.Key == key {
			return section, true
		}
	}
	return WorkflowSection{}, false
}
